{
  "functions": {
    "api/shopify-webhook.js": { "maxDuration": 30 },
    "api/sync-products-cache.js": { "maxDuration": 60 },
    "api/sync-return-to-shopify.js": { "maxDuration": 60 },
    "api/shopify-order-webhook.js": { "maxDuration": 15 },
    "api/list-shopify-locations.js": { "maxDuration": 10 },
    "api/notifications.js": { "maxDuration": 10 },
    "api/sync-rupture-shopify.js": { "maxDuration": 60 },
    "api/unsync-item.js": { "maxDuration": 30 },
    "api/oauth-callback.js": { "maxDuration": 15 },
    "api/setup-webhooks.js": { "maxDuration": 15 },
    "api/test-order-webhook.js": { "maxDuration": 15 },
    "api/selftest-webhook.js": { "maxDuration": 20 },
    "api/diag-orders.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/livreur", "destination": "/livreur.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
