{
  "crons": [
    {
      "path": "/api/ai-reply?secret=touni-sync-2026&morning_ping=1",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/ai-reply?secret=touni-sync-2026&stock_check=1",
      "schedule": "0 11 * * *"
    }
  ],
  "functions": {
    "api/shopify-webhook.js": { "maxDuration": 30 },
    "api/sync-products-cache.js": { "maxDuration": 60 },
    "api/sync-return-to-shopify.js": { "maxDuration": 60 },
    "api/shopify-order-webhook.js": { "maxDuration": 15 },
    "api/list-shopify-locations.js": { "maxDuration": 10 },
    "api/notifications.js": { "maxDuration": 60 },
    "api/sync-rupture-shopify.js": { "maxDuration": 60 },
    "api/unsync-item.js": { "maxDuration": 30 },
    "api/oauth-callback.js": { "maxDuration": 15 },
    "api/setup-webhooks.js": { "maxDuration": 15 },
    "api/snapshot-inventory.js": { "maxDuration": 60 },
    "api/ai-reply.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/dashboard", "destination": "/dashboard.html" },
    { "source": "/livreur", "destination": "/livreur.html" },
    { "source": "/commandes-stock", "destination": "/commandes-stock.html" },
    { "source": "/commandes", "destination": "/commandes-stock.html" },
    { "source": "/historique", "destination": "/historique.html" },
    { "source": "/top-produits", "destination": "/bestsellers.html" },
    { "source": "/best-sellers", "destination": "/bestsellers.html" },
    { "source": "/rupture", "destination": "/rupture.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ]
}
